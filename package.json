{
  "name": "nicobar-batch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev --var DEV_MODE:1 --var DEV_ACTOR:dev@local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars false",
    "check:config": "node scripts/check-config.ts",
    "predeploy:check": "node scripts/predeploy-check.ts",
    "stub-llm": "node scripts/stub-llm.ts",
    "smoke": "node scripts/smoke.ts",
    "build": "npm run check:config && node scripts/build.ts",
    "eval": "node scripts/eval.ts",
    "readiness": "node scripts/readiness.ts",
    "config": "node scripts/config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "22.15.17",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@cfworker/json-schema": "4.1.4",
    "jose": "6.2.14"
  }
}
